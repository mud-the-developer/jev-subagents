# Export this in your shell before starting pi. This file is not auto-loaded.
# Obtain a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Optional OpenJEV. Uncomment only after explicitly choosing this backend.
# Not auto-loaded; local server/model deployment is separate.
# JEV_BACKEND=openjev
# OPENJEV_BASE_URL=http://127.0.0.1:8080
# OPENJEV_MODEL=openjev-0.1
# OPENJEV_API_KEY=
# Remote supported origin: https://api.codiv.ai (requires its own key).
